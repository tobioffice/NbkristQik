# Local operations values for scripts/deploy.sh, scripts/deploy-monitor.sh and
# scripts/backup-db.sh. Copy to .env.deploy (gitignored) and fill in real
# values there. Nothing in this file is read by the running bot.
#
# Production deploys from GitHub Actions do not use this file: they read the
# same names from GitHub secrets. See docs/DEPLOYMENT.md.
#
# The placeholders use TEST-NET addresses (203.0.113.0/24); replace them.

# --- production host -------------------------------------------------------
DEPLOY_HOST=deploy-host
DEPLOY_DIR=/home/ubuntu/nbkristqik
DEPLOY_SERVICE=nbkristqik
DEPLOY_BASE_URL=http://127.0.0.1:3000
# DEPLOY_DB_URL=file:/home/ubuntu/nbkristqik/data/qik.db
# DEPLOY_INTERNAL_SECRET=<same value as UPTIME_INGEST_SECRET>

# --- external uptime monitor ----------------------------------------------
MONITOR_RELAY=monitor-relay
MONITOR_HOST=203.0.113.10
MONITOR_USER=ubuntu
MONITOR_DIR=/opt/nbkristqik-uptime
MONITOR_SERVICE=nbkristqik-uptime
MONITOR_ENV=/etc/nbkristqik-uptime.env

# --- nightly off-box backup ------------------------------------------------
BACKUP_REMOTE=backup-user@203.0.113.11
BACKUP_REMOTE_DIR=/home/backup/qik-backups
