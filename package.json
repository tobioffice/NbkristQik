{
    "name": "nbkristqik",
    "version": "1.0.0",
    "main": "dist/bot/index.js",
    "type": "module",
    "scripts": {
        "start": "node dist/bot/index.js",
        "build": "tsc",
        "dev": "node --loader ts-node/esm src/bot/index.ts",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "typecheck": "tsc --noEmit",
        "typecheck:tests": "tsc -p tsconfig.test.json",
        "verify": "pnpm run typecheck && pnpm run typecheck:tests && pnpm run lint && pnpm exec vitest run",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "description": "",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@libsql/client": "^0.18.0",
        "axios": "^1.20.0",
        "cheerio": "^1.2.0",
        "cors": "^2.8.6",
        "dotenv": "^16.4.7",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "express-validator": "^7.3.2",
        "node-telegram-bot-api": "^0.66.0",
        "pdf-lib": "^1.17.1",
        "redis": "^5.8.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node-telegram-bot-api": "^0.64.7",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "@vitest/coverage-v8": "^2.1.9",
        "@vitest/ui": "^2.1.8",
        "domhandler": "^6.0.1",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "happy-dom": "^21.0.4",
        "prettier": "^3.9.10",
        "supertest": "^7.3.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vitest": "^2.1.9"
    }
}
