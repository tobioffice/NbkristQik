# Environment selection. Unset now defaults to "production" (fail closed);
# a development checkout must opt in explicitly.
# ENV=production
ENV=development

# Allow an unsigned numeric userId query/body field as identity. Development
# only. It must be opted into explicitly here (ENV=test also enables it for the
# test suite); ENV=development alone is not enough. Never set this in
# production.
# ALLOW_DEV_IDENTITY=1

# Telegram Bot Tokens
TELEGRAM_BOT_TOKEN_DEV=your_dev_bot_token_here
TELEGRAM_BOT_TOKEN=your_production_bot_token_here

# Turso Database Configuration (used when LOCAL_DB_URL is unset)
TURSO_DATABASE_URL=your_database_url_here
TURSO_AUTH_TOKEN=your_auth_token_here

# Embedded database (optional): a local SQLite/libSQL file that takes
# precedence over Turso — no network hop, no read quota.
# LOCAL_DB_URL=file:/home/ubuntu/nbkristqik/data/qik.db

# Redis Configuration
REDIS_URL=your_redis_url_here

# Authentication Credentials
N_USERNAME=your_username_here
N_PASSWORD=your_password_here

# Admin Configuration
ADMIN_ID=your_admin_id_here

# Channel Configuration
PROD_CHANNEL=your_prod_channel_here
TEST_CHANNEL=your_test_channel_here

# College portal base URL. Leave unset to use the built-in default; set it
# only if the portal moves or starts supporting HTTPS (login credentials
# are POSTed to `${PORTAL_BASE_URL}/attendance/attendanceLogin.php`).
# PORTAL_BASE_URL=

# API bind address and port. Keep the API on loopback and let nginx terminate
# TLS; the deploy script smoke-checks http://127.0.0.1:3000 from the server.
# HOST=127.0.0.1
# PORT=3000

# Comma-separated CORS allowlist for the web leaderboard origin(s).
# Defaults to https://checker.tobioffice.dev. The library app and status page
# are served from this same origin (at /library/ and /status), so neither needs
# an entry here; add a host only for a separate frontend (e.g. local dev).
# CORS_ORIGINS=https://checker.tobioffice.dev,http://localhost:5173

# External uptime monitor (runs on oracle2). Both hosts must carry the same
# secret; when it is unset the private /internal routes are disabled.
# Generate one with: openssl rand -hex 32
# UPTIME_INGEST_SECRET=

# Monitor-only settings (not read by the bot). On oracle2, set
# MONITOR_TELEGRAM_BOT_TOKEN to a dedicated alert bot; it falls back to
# TELEGRAM_BOT_TOKEN only for a single-host development setup.
# MONITOR_BASE_URL=https://checker.tobioffice.dev
# MONITOR_PORTAL_URL=http://103.203.175.91
# MONITOR_STATE_DIR=/var/lib/nbkristqik-uptime
# MONITOR_INTERVAL_MS=300000
# MONITOR_TIMEOUT_MS=10000
# MONITOR_CONFIRM_MS=45000
# MONITOR_TELEGRAM_BOT_TOKEN=
# Synthetic answer canary: set both to add the "lookup" probe. CANARY_ROLL
# must be a real roll already present in studentsnew; no sync step is added.
# CANARY_ENABLED=1
# CANARY_ROLL=23KB1A0599

# Admin panel (optional — panel is disabled unless both are set)
# The panel is served at https://your-domain/<ADMIN_PANEL_PATH> and
# protected by ADMIN_PANEL_PASSWORD. Use an unguessable path segment.
# ADMIN_PANEL_PATH=control-x7k2q9
# ADMIN_PANEL_PASSWORD=choose-a-long-password

# Who may open the library mini app. "admin" keeps it to ADMIN_ID while the
# shelf is being filled; "all" opens it to every registered student.
# LIBRARY_ACCESS=admin

# Secret behind the library's watermark tokens. Falls back to the bot token.
# Set a dedicated value so marks survive a bot token change. With neither set,
# library pages answer 503 rather than printing a token anyone could forge.
# LIBRARY_WATERMARK_SECRET=

# Disk budget for the per-reader watermarked PDF cache in data/downloads.
# Copies older than seven days are dropped; the oldest go first until the
# tree fits this budget.
# LIBRARY_DOWNLOAD_CACHE_MB=512
